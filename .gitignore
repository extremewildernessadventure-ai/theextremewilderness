# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
next-start.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# `wrangler types` / `npm run cf-typegen` output — deliberately not used by
# this project (declares a global Response/Body that conflicts with
# lib.dom's, breaking `res.json()` typing everywhere `fetch` is called; see
# src/lib/r2.ts and src/lib/db.ts for the hand-written-types alternative).
cloudflare-env.d.ts

# compression script (dev only)
/scripts/compress-images.mjs

.vercel

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# generated per-locale data assets (regenerated from src/data on every build).
# Excludes contents (trailing /*, not a bare trailing /) rather than the
# directory itself, specifically so the negation below can still reach into
# it -- git never descends into a directory excluded as a unit to evaluate
# per-file re-include rules.
/public/locale-data/*
# ...except reviews.json: unlike every other file in this directory, it has
# no checked-in source to regenerate from (it's a snapshot of real D1 review
# rows, not static *.ts content) -- CI has no access to the real production
# D1 at build time, so this one file is committed, versioned content, kept
# up to date by re-running scripts/generate-review-data.ts locally and
# committing the diff whenever a new review is approved. See that script's
# and src/lib/reviews.ts's own comments for the full reasoning.
!/public/locale-data/reviews.json

# generated content-freshness dates for the sitemap (regenerated from git log)
/src/data/generated/

# ad-hoc lighthouse audit output (scripts/lighthouse-audit.mjs)
/lighthouse-reports/
