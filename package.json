{
  "name": "extreme-wilderness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsx scripts/generate-locale-data.ts && next build",
    "dev": "tsx scripts/generate-locale-data.ts && next dev",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "generate:locale-data": "tsx scripts/generate-locale-data.ts",
    "submit-indexnow": "node scripts/submit-indexnow.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@mapbox/geojson-rewind": "^0.5.2",
    "d3-geo": "^3.1.1",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "next-intl": "^4.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "resend": "^6.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "lighthouse": "^13.4.0",
    "mapshaper": "^0.7.51",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.118.0"
  }
}
