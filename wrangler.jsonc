{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "extreme-wilderness",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// Default "auto-trailing-slash" 307-redirects /foo.html -> /foo, which
		// breaks the Yandex ownership-verification file (yandex_*.html) since
		// verifiers don't follow redirects. This is the only static .html file
		// in the asset bundle, so disabling clean-URL handling is safe.
		"html_handling": "none"
	},
	"workers_dev": false,
	"routes": [
		{ "pattern": "www.theextremewilderness.com", "custom_domain": true },
		{ "pattern": "theextremewilderness.com", "custom_domain": true }
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "extreme-wilderness"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ewa-invoices",
			"database_id": "5e76d144-3c2b-4d35-8bc1-763aa1f67f36"
		}
	],
	// NOTE: this bucket does not exist in the real Cloudflare account yet —
	// run `wrangler r2 bucket create ewa-documents` before this branch is
	// ever deployed. Local dev/testing works today without it: `--local`
	// uses Miniflare's local R2 simulator, same as D1's `--local` flag.
	"r2_buckets": [
		{
			"binding": "DOCS",
			"bucket_name": "ewa-documents"
		}
	],
	// Renders the booking-voucher HTML into a real PDF server-side
	// (src/lib/browser.ts). Requires a Cloudflare plan with Browser
	// Rendering enabled — verify this before relying on the voucher
	// send feature; see the spike route noted in src/lib/browser.ts.
	"browser": {
		"binding": "BROWSER"
	}
}